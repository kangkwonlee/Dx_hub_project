def Xform "Workbench"
{
    def "Looks"
    {
        def Material "DeskWhite"
        {
            token outputs:surface.connect = </Workbench/Looks/DeskWhite/S.outputs:surface>

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.89, 0.86)
                float inputs:opacity = 1
                float inputs:roughness = 0.6
